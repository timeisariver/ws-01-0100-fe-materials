{
  // Prettier の設定ファイル(.prettierrc)があるディレクトリのみフォーマットする。
  // 現状 .prettierrc を持つのは 0200-js-base のみなので、自動フォーマットはそこだけに効く。
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,
  // ユーザー設定の言語別 defaultFormatter(vscode.typescript-language-features)を
  // 上書きするために、言語別にも Prettier を指定する。
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
